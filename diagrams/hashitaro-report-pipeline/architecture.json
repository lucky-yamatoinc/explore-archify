  "cards": [
    {
      "dot": "cyan",
      "title": "Main path",
      "items": [
        "app or sketch app → backend: validate, bill, then queue",
        "worker → HC for classification & scenarios → renderer → S3",
        "app polls status every 5 s, downloads via signed URL"
      ]
    },
    {
      "dot": "emerald",
      "title": "Contracts",
      "items": [
        "Backend resolves every value; Go only validates and places",
        "Backend → HC has no shared schema (status: unconfirmed)",
        "Some formats render in the backend, not through Go"
      ]
    },
    {
      "dot": "amber",
      "title": "Common failure points",
      "items": [
        "Go 409: all render slots busy, never queued",
        "Go 504: render timeout",
        "HealthClassifierJobLost: HC job lost on redeploy"
      ]
    },
    {
      "dot": "slate",
      "title": "Not drawn",
      "items": [
        "hashitaro-common & api-contract (backend/HC submodules)",
        "hashitaro-mdb: optional Hiroshima .mdb package",
        "Report status storage & regeneration WebSocket"
      ]
    }
  ]
